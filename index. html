    <!-- 10. CART DRAWER -->
    <div id="cartDrawer" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex justify-end hidden">
        <div class="bg-white w-full max-w-md h-full p-6 shadow-2xl flex flex-col justify-between">
            <div>
                <div class="flex justify-between items-center pb-4 border-b border-slate-200">
                    <h3 class="text-lg font-black text-clasmo-navy flex items-center gap-2">
                        <i class="fa-solid fa-basket-shopping text-clasmo-teal"></i> Test Cart (<span id="cartHeaderCount">0</span>)
                    </h3>
