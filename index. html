    <!-- TOAST ALERT -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 bg-clasmo-navy text-white px-5 py-3 rounded-2xl shadow-2xl flex items-center gap-3 transform translate-y-20 opacity-0 transition-all duration-300">
        <i class="fa-solid fa-circle-check text-clasmo-emerald text-lg"></i>
        <span id="toastText" class="text-xs font-bold">Action completed!</span>
    </div>

    <!-- Application JavaScript Code -->
    <script>
        // Diagnostic Tests Data
        const testsCatalog = [
            {
                id: 'full-body',
                name: 'Full Body Wellness Checkup',
                category: 'Wellness',
                parameters: '60+ Vital Parameters (CBC, Lipid, LFT, KFT, Thyroid)',
                price: 1499,
                mrp: 2999,
                fasting: '10-12 hrs Fasting Required',
                tat: 'Reports in 24 hrs',
                popular: true
            },
            {
                id: 'cbc',
                name: 'Complete Blood Count (CBC)',
                category: 'Pathology',
                parameters: '15 Parameters (Hb, TLC, DLC, RBC, Platelets)',
                price: 299,
                mrp: 450,
                fasting: 'No Fasting Required',
                tat: 'Reports in 6 hrs',
                popular: true
            },
            {
                id: 'thyroid',
                name: 'Thyroid Profile Total (T3, T4, TSH)',
                category: 'Vitamins',
                parameters: '3 Hormonal Parameters for Metabolism',
                price: 399,
                mrp: 750,
                fasting: 'Morning Sample Preferred',
                tat: 'Reports in 12 hrs',
                popular: true
            },
            {
                id: 'diabetes',
                name: 'Diabetes Care Profile',
                category: 'Diabetes',
                parameters: 'HbA1c, Fasting Glucose, Urine Microalbumin',
                price: 699,
                mrp: 1200,
                fasting: '8-10 hrs Fasting Required',
                tat: 'Reports in 8 hrs',
                popular: false
            },
            {
                id: 'lipid',
                name: 'Lipid Profile (Cardiac Health)',
                category: 'Diabetes',
                parameters: 'Total Cholesterol, Triglycerides, HDL, LDL',
                price: 499,
                mrp: 900,
                fasting: '12 hrs Fasting Required',
                tat: 'Reports in 12 hrs',
                popular: false
            },
            {
                id: 'vit-combo',
                name: 'Vitamin D3 & B12 Combo',
                category: 'Vitamins',
                parameters: 'Bone Strength & Nerve Health Indicators',
                price: 899,
                mrp: 1800,
                fasting: 'No Fasting Required',
                tat: 'Reports in 24 hrs',
                popular: true
            }
        ];

        let cartItems = [];

        window.addEventListener('DOMContentLoaded', () => {
            renderTestCards(testsCatalog);
            // Default date picker to tomorrow
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            document.getElementById('bookDate').value = tomorrow.toISOString().split('T')[0];
        });

        // Render Test Cards Grid
        function renderTestCards(data) {
            const grid = document.getElementById('testsGrid');
            if (!grid) return;

            if (data.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-12 text-slate-400 font-semibold">No diagnostic tests matching your search query.</div>`;
                return;
            }

            grid.innerHTML = data.map(test => `
                <div class="glass-card rounded-3xl p-6 card-hover-effect flex flex-col justify-between border border-slate-200/80 relative">
                    ${test.popular ? `<span class="absolute top-4 right-4 bg-amber-100 text-amber-800 text-[10px] font-black px-3 py-0.5 rounded-full uppercase">Popular</span>` : ''}
                    <div>
                        <span class="text-[10px] font-black uppercase tracking-wider text-clasmo-teal bg-teal-50 px-2.5 py-0.5 rounded-md border border-teal-100">${test.category}</span>
                        <h3 class="text-lg font-black text-clasmo-navy mt-2">${test.name}</h3>
                        <p class="text-xs text-slate-500 font-medium mt-1"><i class="fa-solid fa-vial text-clasmo-teal mr-1"></i> ${test.parameters}</p>

                        <div class="mt-4 pt-3 border-t border-slate-100 space-y-1 text-xs text-slate-600 font-medium">
                            <div class="flex items-center gap-2"><i class="fa-regular fa-clock text-slate-400"></i> ${test.tat}</div>
                            <div class="flex items-center gap-2"><i class="fa-solid fa-utensils text-slate-400"></i> ${test.fasting}</div>
                        </div>
                    </div>

                    <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                        <div>
                            <div class="flex items-baseline gap-1.5">
                                <span class="text-2xl font-black text-clasmo-navy">₹${test.price}</span>
                                <span class="text-xs text-slate-400 line-through">₹${test.mrp}</span>
                            </div>
                            <span class="text-[10px] font-extrabold text-emerald-600">${Math.round((1 - test.price/test.mrp)*100)}% DISCOUNT</span>
                        </div>

                        <button onclick="addToCart('${test.id}')" class="px-4 py-2.5 bg-clasmo-navy hover:bg-clasmo-teal text-white text-xs font-bold rounded-xl shadow-md transition-all flex items-center gap-1.5">
                            <i class="fa-solid fa-cart-plus"></i> Add
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // Category Filter
        function filterCategory(cat) {
            document.querySelectorAll('.cat-btn').forEach(btn => {
                if (btn.getAttribute('data-cat') === cat) {
                    btn.classList.add('bg-clasmo-navy', 'text-white');
                    btn.classList.remove('bg-white', 'text-slate-700');
                } else {
                    btn.classList.remove('bg-clasmo-navy', 'text-white');
                    btn.classList.add('bg-white', 'text-slate-700');
                }
            });

            if (cat === 'all') {
                renderTestCards(testsCatalog);
            } else {
                renderTestCards(testsCatalog.filter(t => t.category === cat));
            }
        }

        // Filter by Query
        function filterTestsByQuery(query) {
            const q = query.toLowerCase().trim();
            const clearBtn = document.getElementById('clearSearchBtn');
            if (clearBtn) {
                if (q.length > 0) clearBtn.classList.remove('hidden');
                else clearBtn.classList.add('hidden');
            }

            const filtered = testsCatalog.filter(t => 
                t.name.toLowerCase().includes(q) || 
                t.parameters.toLowerCase().includes(q) || 
                t.category.toLowerCase().includes(q)
            );
            renderTestCards(filtered);
        }

        // Cart Drawer Operations
        function addToCart(testId) {
            const test = testsCatalog.find(t => t.id === testId);
            if (!test) return;

            if (!cartItems.some(c => c.id === testId)) {
                cartItems.push(test);
                updateCartUI();
                showToast(`"${test.name}" added to cart!`);
            } else {
                showToast('Test is already in your cart.');
            }
        }

        function removeFromCart(testId) {
            cartItems = cartItems.filter(c => c.id !== testId);
            updateCartUI();
            showToast('Test removed from cart.');
        }

        function updateCartUI() {
            const badge = document.getElementById('cartBadge');
            const headerCount = document.getElementById('cartHeaderCount');
            const cartList = document.getElementById('cartList');
            const totalPrice = document.getElementById('cartTotalPrice');

            badge.innerText = cartItems.length;
            headerCount.innerText = cartItems.length;

            if (cartItems.length > 0) badge.classList.remove('hidden');
            else badge.classList.add('hidden');

            if (cartItems.length === 0) {
                cartList.innerHTML = `<div class="text-center py-12 text-slate-400 text-sm">Your test cart is empty.</div>`;
                totalPrice.innerText = '₹0';
                return;
            }

            let total = 0;
            cartList.innerHTML = cartItems.map(item => {
                total += item.price;
                return `
                    <div class="flex justify-between items-center p-3.5 bg-slate-50 rounded-2xl border border-slate-200">
                        <div>
                            <div class="font-extrabold text-xs text-slate-800">${item.name}</div>
                            <div class="text-xs text-clasmo-teal font-extrabold mt-0.5">₹${item.price}</div>
                        </div>
                        <button onclick="removeFromCart('${item.id}')" class="text-rose-500 hover:text-rose-700 text-xs p-1">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                `;
            }).join('');

            totalPrice.innerText = `₹${total}`;
        }

        function toggleCartDrawer() {
            document.getElementById('cartDrawer').classList.toggle('hidden');
        }

        // Modals Operations
        function closePromoModal() {
            document.getElementById('promoModal').classList.add('hidden');
        }

        function applyPromoCode(code) {
            showToast(`Promo Code ${code} Applied! 20% Discount active.`);
            closePromoModal();
        }

        function openBookingModal() {
            document.getElementById('bookingModal').classList.remove('hidden');
        }

        function closeBookingModal() {
            document.getElementById('bookingModal').classList.add('hidden');
        }

        function openSampleReport(title, date) {
            document.getElementById('reportTitle').innerText = title;
            document.getElementById('reportDate').innerText = 'Verified Date: ' + date;
            document.getElementById('reportModal').classList.remove('hidden');
        }

        function closeSampleReport() {
            document.getElementById('reportModal').classList.add('hidden');
        }

        function toggleMobileMenu() {
            document.getElementById('mobileMenu').classList.toggle('hidden');
        }

        // Booking Form Submission
        function handleBookingSubmission(e) {
            e.preventDefault();
            const name = document.getElementById('bookName').value;
            const phone = document.getElementById('bookPhone').value;
            const bookingId = '#CLS-' + Math.floor(10000 + Math.random() * 90000);

            document.getElementById('resBookingId').innerText = bookingId;
            document.getElementById('resName').innerText = name;
            document.getElementById('resPhone').innerText = phone;

            closeBookingModal();
            document.getElementById('successModal').classList.remove('hidden');
            e.target.reset();
        }

        function closeSuccessModal() {
            document.getElementById('successModal').classList.add('hidden');
        }

        // Toast Helper
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastText').innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
